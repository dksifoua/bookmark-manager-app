{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "bookmark_manager_app": "Debug"
    }
  },
  "Console": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "DetailedErrors": true,
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bookmark;Username=admin;Password=secret"
  },
  "Jwt": {
    "Key": "a-string-secret-at-least-256-bits-long",
    "Issuer": "bookmark-manager-api",
    "Audience": "bookmark-manager-client",
    "DurationInMinutes": 60
  },
  "AllowedCorsOrigins": ["http://localhost:5173"]
}