{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
        }
    },
    "AppSettings": {
        "ApplicationName": "Bookmark Manager API",
        "ApplicationVersion": "1.0.0"
    },
    "AllowedHosts": "*",
    "AllowedCorsOrigins": ["http://localhost:5173"],
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=bookmark;User Id=admin;Password=secret;"
    },
    "JwtSettings": {
        "Key": "a-string-secret-at-least-256-bits-long",
        "Issuer": "BookmarkManagerApi",
        "Audience": "BookmarkManagerApiUsers",
        "DurationInMinutes": 60
    }
}
