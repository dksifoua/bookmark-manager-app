Content-Type: application/json
Accept: application/json
Cookie: token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7Cn97BNjtX047TgqURJOGCAQfykU1lMiV5pErQQvgEU; max-age=3600; path=/; samesite=strict; httponly

{
    "title": "GitHub",
    "url": "https://github.com",
    "description": "Where the world builds software. Millions of developers and companies build, ship, and maintain their software on GitHub."
}

